{
  "_metadata": {
    "major_version": 1,
    "minor_version": 1
  },
  "display_information": {
    "name": "Kaltura Agent",
    "description": "Chat with your Kaltura conversational agent in Slack.",
    "background_color": "#006efa"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    },
    "bot_user": {
      "display_name": "Kaltura Agent",
      "always_online": true
    },
    "agent_view": {
      "agent_description": "Ask questions and get answers, sources and video clips from your Kaltura agent. Click 'Talk to the avatar' to open the video avatar.",
      "suggested_prompts": [
        {
          "title": "What can you do?",
          "message": "What can you help me with?"
        },
        {
          "title": "Find a video",
          "message": "Find a video that explains how to get started."
        }
      ]
    },
    "unfurl_domains": [
      "kaltura.com"
    ],
    "slash_commands": [
      {
        "command": "/talk",
        "description": "Start a live, hands-free voice call with the Kaltura avatar",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "assistant:write",
        "app_mentions:read",
        "chat:write",
        "im:history",
        "im:read",
        "im:write",
        "links:read",
        "links.embed:write",
        "metadata.message:read",
        "files:read",
        "commands",
        "calls:write"
      ],
      "user": [
        "links.embed:write"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_home_opened",
        "app_mention",
        "message.im",
        "link_shared",
        "agent_session_stopped",
        "entity_details_requested"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
