# ── Slack ──────────────────────────────────────────────────────────────
# Bot token (OAuth & Permissions → Bot User OAuth Token)
SLACK_BOT_TOKEN=xoxb-...
# App-level token with the connections:write scope (Basic Information → App-Level Tokens)
SLACK_APP_TOKEN=xapp-...

# ── Kaltura ────────────────────────────────────────────────────────────
# Set to 1 to try the Slack side with a fake agent (no Kaltura credentials needed).
MOCK_KALTURA=0
KALTURA_PARTNER_ID=
# Admin secret: stays on this server, never sent to Slack or the browser.
KALTURA_ADMIN_SECRET=
# The agent to talk to (from provision(), the quickstart CLI, or your Kaltura console).
KALTURA_AGENT_ID=
# Optional: the agent's intellect/config id (looked up from the agent when empty).
KALTURA_CONFIG_ID=
# Optional: region for non-US partners, e.g. frp2
KALTURA_REGION=
# Optional: player uiConf id for clip embeds
KALTURA_UICONF_ID=
# Optional: fast | smart
KALTURA_MODEL_TYPE=

# ── Avatar panel (optional) ────────────────────────────────────────────
# Public HTTPS URL that reaches this server's PORT (ngrok / cloudflared / your host).
# Leave empty to turn the avatar panel off.
PUBLIC_BASE_URL=
# Random string, 32+ characters: openssl rand -hex 32
EMBED_SIGNING_SECRET=
PORT=3000

# 1 = answer every message in its own thread. 0 (default) = top-level replies, one continuing conversation.
SLACK_THREAD_REPLIES=0

# Set to 0 if Slack rejects video blocks; clips are then shown as links.
SLACK_VIDEO_BLOCKS=1
